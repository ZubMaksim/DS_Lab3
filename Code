cat("\nОбчислюємо пермутаційну важливість (зростання RMSE при перемішуванні ознаки)...\n")
perm_importance <- function(model, test_df, response_name, features, metric = function(obs, pred) sqrt(mean((obs - pred)^2)), n_repeats = 25) {
  bas_pred <- predict(model, newdata = test_df)
  bas_metric <- metric(test_df[[response_name]], bas_pred)
  res <- data.frame(feature = features, mean_increase = NA_real_, sd_increase = NA_real_)
  for (i in seq_along(features)) {
    feat <- features[i]
    vals <- numeric(n_repeats)
    for (r in 1:n_repeats) {
      tmp <- test_df
      tmp[[feat]] <- sample(tmp[[feat]])
      pred <- predict(model, newdata = tmp)
      vals[r] <- metric(test_df[[response_name]], pred) - bas_metric
    }
    res$mean_increase[i] <- mean(vals)
    res$sd_increase[i] <- sd(vals)
    if (i %% 2 == 0) cat(".") # faint progress
  }
  cat("\n")
  res %>% arrange(desc(mean_increase))
}

