cat("\nBootstrap стабільність: тренуємо кілька RF на bootstrap вибірках і збираємо важливості...\n")
n_boot <- 30
cores_avail <- parallel::detectCores()
cl <- makeCluster(max(1, cores_avail - 1))
registerDoParallel(cl)

boot_imp_list <- foreach(i = 1:n_boot, .packages = c("randomForest")) %dopar% {
  set.seed(500 + i)
  idx_b <- sample(1:nrow(train), replace = TRUE)
  tr_b <- train[idx_b, ]
  m_b <- randomForest(rf_formula, data = tr_b, ntree = 200)
