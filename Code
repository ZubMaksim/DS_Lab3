preds_matrix <- sapply(valid_boots, function(x) predict(x$model, newdata = test))
if (!is.null(preds_matrix) && is.matrix(preds_matrix)) {
  preds_mean <- rowMeans(preds_matrix)
  preds_sd <- apply(preds_matrix, 1, sd)
  pred_stability_df <- data.frame(site = test[[id_col]], obs = test$security_index_pca, pred_mean = preds_mean, pred_sd = preds_sd)
  write_csv(pred_stability_df, file.path(diag_dir, "bootstrap_prediction_stability.csv"))
} else {
  pred_stability_df <- data.frame()
}

# 21) Простий ансамбль
cat("\nСтворення простого ансамблю (усереднення RF, тренованих на різних seed)...\n")
ensemble_seeds <- c(11,22,33)
ensemble_models <- lapply(ensemble_seeds, function(s) {
  set.seed(s)
  randomForest(rf_formula, data = train, ntree = 300)
})
preds_ensemble <- sapply(ensemble_models, function(m) predict(m, newdata = test))
pred_ensemble_mean <- rowMeans(preds_ensemble)
ensemble_rmse <- sqrt(mean((pred_ensemble_mean - test$security_index_pca)^2))
ensemble_mae <- mean(abs(pred_ensemble_mean - test$security_index_pca))
cat(sprintf("Ensemble RMSE = %.4f, MAE = %.4f\n", ensemble_rmse, ensemble_mae))

