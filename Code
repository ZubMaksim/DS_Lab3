  list(imp = imp_b, model = m_b)
}
stopCluster(cl)

# Фільтруємо NULL важливості
valid_boots <- Filter(function(x) !is.null(x$imp), boot_imp_list)
if (length(valid_boots) > 0) {
  imp_mat <- do.call(cbind, lapply(valid_boots, function(x) {
    im <- x$imp
    if (is.matrix(im) || is.data.frame(im)) {
      im <- as.data.frame(im)
      numcol <- which(sapply(im, is.numeric))[1]
      return(im[[numcol]])
    } else return(rep(NA, nrow(im)))
  }))
  imp_mean <- rowMeans(imp_mat, na.rm = TRUE)
  imp_sd <- apply(imp_mat, 1, sd, na.rm = TRUE)
  imp_boot_df <- data.frame(feature = rownames(valid_boots[[1]]$imp), mean_importance = imp_mean, sd_importance = imp_sd) %>%
    arrange(desc(mean_importance))
  write_csv(imp_boot_df, file.path(diag_dir, "bootstrap_importance_summary.csv"))
  print(head(imp_boot_df))
} else {
